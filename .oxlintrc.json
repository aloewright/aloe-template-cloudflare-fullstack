{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "dist",
    ".wrangler",
    "node_modules",
    "docs",
    "worker/migrations",
    "src/routeTree.gen.ts"
  ]
}
