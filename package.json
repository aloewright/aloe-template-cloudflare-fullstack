{
  "name": "warp-template-cloudflare-fullstack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "check": "oxlint --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:deploy": "npm --prefix docs run build && npx wrangler deploy --cwd docs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@gfazioli/mantine-audio": "^1.1.0",
    "@mantine/carousel": "^9.5.0",
    "@mantine/core": "^9.5.0",
    "@mantine/dates": "^9.5.0",
    "@mantine/dropzone": "^9.5.0",
    "@mantine/form": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@mantine/modals": "^9.5.0",
    "@mantine/notifications": "^9.5.0",
    "@mantine/nprogress": "^9.5.0",
    "@mantine/spotlight": "^9.5.0",
    "@polar-sh/sdk": "^0.49.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "better-auth": "^1.6.25",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.12.33",
    "jose": "^6.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tus-js-client": "^4.3.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.25",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
