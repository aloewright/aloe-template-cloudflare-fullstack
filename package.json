{
  "name": "warp-template-cloudflare-fullstack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:worker\"",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:worker": "WRANGLER_LOG_PATH=.wrangler/logs/wrangler.log WRANGLER_REGISTRY_PATH=.wrangler/registry wrangler --cwd worker dev -c ../wrangler.toml --port 8787 --ip 127.0.0.1",
    "build": "vite build && tsc -p worker/tsconfig.json --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "docs:dev": "npm --prefix docs run start",
    "docs:build": "npm --prefix docs run build",
    "docs:deploy": "npm --prefix docs run build && npx wrangler pages deploy docs/build --project-name template-docs"
  },
  "dependencies": {
    "@mantine/core": "^9.2.2",
    "@mantine/form": "^9.2.2",
    "@mantine/hooks": "^9.2.2",
    "@mantine/modals": "^9.2.2",
    "@mantine/notifications": "^9.2.2",
    "@polar-sh/sdk": "^0.47.1",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.120.0",
    "better-auth": "^1.5.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@cloudflare/workers-types": "^4.2026.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.0",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "wrangler": "^4.0.0"
  }
}
