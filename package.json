{
  "name": "warp-template-cloudflare-fullstack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:worker\"",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:worker": "WRANGLER_LOG_PATH=.wrangler/logs/wrangler.log WRANGLER_REGISTRY_PATH=.wrangler/registry wrangler --cwd worker dev -c ../wrangler.toml --port 8787 --ip 127.0.0.1",
    "build": "vite build && tsc -p worker/tsconfig.json --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "check": "oxlint --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:deploy": "npm --prefix docs run build && npx wrangler deploy --cwd docs"
  },
  "dependencies": {
    "@mantine/core": "^9.2.2",
    "@mantine/form": "^9.2.2",
    "@mantine/hooks": "^9.2.2",
    "@mantine/modals": "^9.2.2",
    "@mantine/notifications": "^9.2.2",
    "@polar-sh/sdk": "^0.47.1",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.8",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "jose": "^6.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260527.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.0",
    "oxlint": "^1.68.0",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.95.0"
  }
}
